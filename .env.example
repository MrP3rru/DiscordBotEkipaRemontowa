# Token bota Discord (pobierzesz z Discord Developer Portal)
DISCORD_TOKEN=twoj_token_bota_tutaj

# ID aplikacji bota (Client ID - pobierzesz z Discord Developer Portal)
CLIENT_ID=twoj_client_id_tutaj

# ID Twojego serwera Discord (Guild ID)
GUILD_ID=twoje_guild_id_tutaj

# ID kanału, z którego automatycznie mają być usuwane wiadomości (np. po 1 godzinie)
CLEAN_CHANNEL_ID=twoje_channel_id_tutaj

# Czas życia wiadomości na wybranym kanale (w minutach, np. 60 dla 1 godziny)
MESSAGE_LIFETIME_MINUTES=60

# Jak często bot ma sprawdzać i usuwać stare wiadomości (w minutach, np. 5 dla sprawdzania co 5 minut)
CLEAN_INTERVAL_MINUTES=5

# Port na którym ma działać serwer Express (domyślnie 3000, Render przypisuje go automatycznie)
PORT=3000

# Adres URL do bazy PostgreSQL z Supabase (np. postgresql://postgres.ref:[haslo]@db.ref.supabase.co:5432/postgres)
DATABASE_URL=twój_connection_string_supabase_tutaj

# Liczba najnowszych wiadomości, które automatyczne czyszczenie ma ZAWSZE zostawiać na kanale (np. 3)
KEEP_NEWEST_COUNT=3

# Opóźnienie między usuwaniem kolejnych wiadomości w automatycznym czyszczeniu (w sekundach, np. 2)
AUTOCLEAN_DELAY_SECONDS=2

# ID zarządzanych kanałów głosowych (pokoi prywatnych) - oddzielone przecinkami, jeśli jest ich więcej
MANAGED_VOICE_CHANNEL_IDS=1543629049212182588
